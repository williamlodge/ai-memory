# Install: sudo cp deploy/ai-memory.service /etc/systemd/system/
[Unit]
Description=AI Memory MCP server (memory.williamlodge.com)
After=network.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/projects/ai-memory
EnvironmentFile=/home/admin/projects/ai-memory/.env
ExecStart=/usr/bin/node dist/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
